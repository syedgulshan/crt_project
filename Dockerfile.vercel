# ==============================================================================
# Vercel Container Runtime for Backend Service (app)
# ==============================================================================
FROM node:22-alpine
WORKDIR /app

# Install native dependencies required for better-sqlite3 build
RUN apk add --no-cache python3 make g++

ENV NODE_ENV=production

# Install dependencies
COPY package*.json ./
RUN npm install --omit=dev

# Copy application sources & configuration
COPY tsconfig.json ./
COPY server/ ./server/

# Prepare persistent data and upload directories
RUN mkdir -p data uploads logs

# Vercel will dynamically inject the PORT environment variable
EXPOSE 5000

CMD ["npx", "tsx", "server/src/index.ts"]
